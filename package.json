{
  "name": "unraid-disklocation-next",
  "version": "0.0.0",
  "private": true,
  "description": "Standalone TypeScript service that maps Unraid drives to a tray/bay layout via the unraid-api GraphQL interface",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "build:frontend": "vite build",
    "dev:frontend": "vite"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^20.14.0",
    "vite": "^5.4.0",
    "svelte": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0"
  }
}
