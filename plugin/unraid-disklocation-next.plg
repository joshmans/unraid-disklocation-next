<?xml version='1.0' standalone='yes'?>

<!DOCTYPE PLUGIN [
<!ENTITY name       "unraid-disklocation-next">
<!ENTITY author     "Joshua Mans">
<!ENTITY version    "2026.09.19e">
<!ENTITY launch     "Tools/&name;">
<!ENTITY pluginURL  "https://raw.githubusercontent.com/joshmans/&name;/master/plugin/&name;.plg">
<!ENTITY packageURL "https://github.com/joshmans/&name;/releases/download/v&version;/&name;-&version;.txz">
<!ENTITY sha256     "933f3a87677708a0797b99f3ff8e9f4738c0187cd999313d4931019177157c81">
<!ENTITY pluginLOC  "/boot/config/plugins/&name;">
<!ENTITY emhttpLOC  "/usr/local/emhttp/plugins/&name;">
<!ENTITY rcdLOC     "/usr/local/etc/rc.d">
<!ENTITY supportURL "https://github.com/joshmans/&name;">
]>

<PLUGIN name="&name;"
        author="&author;"
        version="&version;"
        launch="&launch;"
        pluginURL="&pluginURL;"
        icon="server"
        support="&supportURL;"
        min="7.2.0"
>

<!--
    Copyright 2026, Joshua Mans

    Licensed under the MIT License - see LICENSE.

    This is a clean-room rewrite, not derived from unraid-disklocation's GPLv3
    codebase - only the tray-map/SMART-history ideas carry over.

    Distribution model (see ROADMAP.md for the full reasoning): a standalone
    Node.js Single Executable Application binary, built by this repo's own
    CI release pipeline (.github/workflows/release.yml + build/build.sh) and
    published as a Slackware .txz GitHub Release asset - the same convention
    real plugins like Unraid-HBAviewer and unraid-docker-folders use, not the
    old sibling plugin's live-branch-zip approach (that one has no rc.d
    daemon to supervise, this one does).
-->

<CHANGES>
###2026.09.19e
 - Show up as a tile in the Disk Utilities group, not a bare Tools stub (#3)

###2026.09.19d
 - Stop the app inlining itself onto Unraid's Tools page (#2)

###2026.09.19c
 - Blink the tray LED for a bad status and real drive activity (#1)
 - Record the Community Apps feed entry publication in ROADMAP.md

###2026.09.19b
 - Use a letter suffix for same-day releases, not a numeric one
 - Document the two real install bugs found and fixed in ROADMAP.md

###2026.09.19-2
 - Fix upgrades never actually installing new files

###2026.09.19
 - Fix daemon fetch failures against unraid-api after the SEA rework

###2026.09.18-2
 - Merge duplicate CHANGES header in the .plg

###2026.09.18
 - First real installable release. Standalone Node SEA binary daemon, tray/
   bay drive map with a directory-discovered tray-skin + PCIe-carrier gallery,
   role/pool/size display, brand-logo system (hotlinked or locally-uploaded
   SVG), classic-plugin import, SMART history charts, and daemon start/stop/
   port control from the Settings tab. See ROADMAP.md for the full history.
 - Add PCIe conversion, role/pool/size display, brand logos, and a real .plg/SEA install pipeline
 - Add importer for tray assignments from the classic Disk Location plugin
 - Rename Storage section's save button to Save Location
 - Rename each Settings save button to reflect its own section
 - Add a Save button to the LED colors section too
 - Add per-section Save buttons in Settings, reorder skins list
 - Color-code daemon status and visually separate Settings sections
 - Replace demo-data fallback with real daemon status + start/restart/port controls
 - Fix rc.d restart race condition that silently left the daemon down
 - Add configurable SMART-history DB location, fix stuck SMART History tab
 - Fix SMART polling to work against SAS drives, not just ATA/NVMe
 - Add SMART-history polling, trend graphs tab, and real critical-status detection
 - Record real-box confirmation of the nginx self-heal fix
 - Self-heal our nginx registration instead of fighting rc.nginx's regeneration
 - Record real-hardware confirmation of the Locate LED blink
 - Add manual "Force (re)detect" button and clarify the no-groups blurb
 - Defer /disks fetch until a bay/PCIe group exists; add Disk Assignment blurb
 - Start Settings from an empty layout on unconfigured production installs
 - Always render LED color Reset button, disabled until an override exists
 - Show empty-state prompt instead of demo trays on unconfigured installs
 - Remove redundant "Disk Location" header
 - Dark-theme-safe styling, tabbed layout, and real nginx findings from a live install
 - Rename Tools-menu title to "Disk Location Next"
 - Flash the whole tray tile on a SMART fault, not just the LED dot
 - Add per-skin LED colors with defaults and a user override
 - Confirm disks query field shapes against live unraid-api; note LED-color idea
 - Add live disk-to-bay assignment with a Locate button
 - Add live PCIe carrier component and a settings UI backed by a real config route
 - Build the tray-map grid layout
 - Move tray skins into the repo as contributable SVG assets
 - Add real GraphQL queries, verified live against a 7.2+ instance
 - Settle runtime packaging: Node.js + SEA, node:sqlite for storage
 - Scaffold .plg daemon distribution: rc.d, nginx conf.d proxy, page, server
 - Rename package to unraid-disklocation-next
</CHANGES>

<!-- Real, live-confirmed Slackware behavior (2026-09-19, against an actual
     install): upgradepkg's "install-new" mode means "install ONLY if nothing by
     this exact package name is already registered in /var/log/packages -
     otherwise skip unconditionally, regardless of whether the file content
     actually changed." An earlier version of this file used a fixed,
     version-less local filename (&name;.txz) specifically so removepkg
     calls could stay version-independent - that choice broke every future
     upgrade forever, since every release registered under the identical
     package name "unraid-disklocation-next" and upgradepkg silently
     skipped every subsequent install with "Skipping package
     unraid-disklocation-next (already installed)". Confirmed live: the
     daemon stayed on the very first installed binary through two
     subsequent releases despite Unraid's own plugin-version bookkeeping
     correctly showing the newer version each time - the outer "is this
     plugin version already installed" check and Slackware's own inner
     package-name check are two entirely separate mechanisms, and only
     encoding &version; into BOTH the release asset name (already done)
     AND this local cache filename keeps them in sync. Matches the real,
     currently-working precedent (unraid-docker-folders) exactly. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
# Defensive cleanup before every install/upgrade: remove any package
# already registered under our name (with or without a version suffix -
# older installs of this same plugin used a version-less package name),
# so the upgradepkg step below never again sees "already installed" and
# silently no-ops. Slackware allows this to run even when nothing matches.
for pkg in /var/log/packages/unraid-disklocation-next*; do
  [ -e "$pkg" ] || continue
  removepkg "$(basename "$pkg")" || true
done
]]>
</INLINE>
</FILE>

<FILE Name="&pluginLOC;/&name;-&version;.txz" Run="upgradepkg --install-new">
<URL>&packageURL;</URL>
<SHA256>&sha256;</SHA256>
</FILE>

<!-- Post-install: seed first-run config (never overwrite existing config -
     this runs on every upgrade too), fix permissions, register the
     array-lifecycle event hook, and (re)start the daemon. Wrapped in CDATA,
     not hand-escaped &amp;&amp;/&lt; - a real Unraid plugin (unraid-docker-folders)
     documents getting this wrong as a silent, whole-plugin-breaking XML
     parse failure.

     IMPORTANT: entity references (&name; etc.) are NOT expanded inside a
     CDATA section - that's the whole point of CDATA (literal text, no
     markup/entity recognition at all). So this script hardcodes its own
     path literals via plain bash variables up top instead of relying on
     substitution - keep these in sync with the DOCTYPE entities above by
     hand if the plugin's name/paths ever change. -->
<FILE Run="/bin/bash">
<INLINE>
<![CDATA[
set -e

NAME="unraid-disklocation-next"
PLUGIN_LOC="/boot/config/plugins/${NAME}"
EMHTTP_LOC="/usr/local/emhttp/plugins/${NAME}"
RCD_LOC="/usr/local/etc/rc.d"

mkdir -p "$PLUGIN_LOC"

# Cleanup from a fixed bug: installs from before the local cache filename
# carried a version stashed the download at a fixed, version-less path -
# harmless leftover cruft now that installs use a versioned filename, but
# no reason to leave it sitting on the flash boot drive.
rm -f "$PLUGIN_LOC/$NAME.txz"

# Cleanup from a fixed bug: v2026.09.19d shipped a Menu="Tools" stub page
# meant to link to the real app elsewhere on the Tools page - it never
# actually got that link and left an empty header there instead. The real
# app page no longer lives under Tools at all (moved to the Disk
# Utilities group), so the stub is now dead weight - upgradepkg only adds/
# overwrites files listed in the new package, it doesn't remove ones only
# the old package shipped, so this has to be deleted explicitly.
rm -f "$EMHTTP_LOC/DiskLocationNextTools.page"

if [ ! -f "$PLUGIN_LOC/layout.json" ]; then
  cat > "$PLUGIN_LOC/layout.json" <<'JSON'
{"layout":{"id":"custom","name":"My chassis","groups":[]},"logos":{}}
JSON
fi

chmod 755 "$RCD_LOC/rc.$NAME"
chmod 755 "$EMHTTP_LOC/app/bin/$NAME"

mkdir -p "$EMHTTP_LOC/event"
cat > "$EMHTTP_LOC/event/started" <<EVENT
#!/bin/bash
# Generated by ${NAME}'s .plg - re-registered on every install/upgrade.
# Brings the daemon back after an array-lifecycle event, the same
# rc.d-supervised-by-event-hook convention other plugin daemons use.
$RCD_LOC/rc.$NAME start
EVENT
chmod 755 "$EMHTTP_LOC/event/started"

# Covers both a fresh install ("just start") and an upgrade-in-place
# ("stop the old binary, start the new one") - the same always-restart
# convention daemon-control.php's own "start" action already uses.
"$RCD_LOC/rc.$NAME" restart

echo "$NAME installed."
]]>
</INLINE>
</FILE>

<!-- Uninstall: stop the daemon, remove the package and everything this
     install script added outside it, undo the nginx include this plugin's
     own daemon self-heals into locations.conf at runtime (best-effort - a
     stopped/removed plugin has nothing left to heal it back), but leave
     PLUGIN_LOC (layout.json, logos/, the SMART-history database) alone -
     every real precedent checked for this project explicitly does not
     delete user config/data on remove. Same CDATA/no-entity-expansion
     caveat as the install script above - hardcoded bash variables, not
     entity references. -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
<![CDATA[
NAME="unraid-disklocation-next"
PLUGIN_LOC="/boot/config/plugins/${NAME}"
EMHTTP_LOC="/usr/local/emhttp/plugins/${NAME}"
RCD_LOC="/usr/local/etc/rc.d"

"$RCD_LOC/rc.$NAME" stop || true

for pkg in /var/log/packages/unraid-disklocation-next*; do
  [ -e "$pkg" ] || continue
  removepkg "$(basename "$pkg")" || true
done

rm -rf "$EMHTTP_LOC"

sed -i "\|include ${PLUGIN_LOC}/nginx/${NAME}.conf;|d" /etc/nginx/conf.d/locations.conf 2>/dev/null || true
nginx -s reload 2>/dev/null || true

echo "$NAME removed. $PLUGIN_LOC (config, layout, logos, SMART history) was left in place."
]]>
</INLINE>
</FILE>

</PLUGIN>
