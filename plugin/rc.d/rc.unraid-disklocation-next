#!/bin/bash
# Lifecycle script for the unraid-disklocation-next daemon.
#
# Installed to /usr/local/etc/rc.d/ (NOT /etc/rc.d/, which Unraid owns as a
# runtime symlink - packaging into it can break nginx/php-fpm/samba/docker).
# Started/stopped via an array-start/array-stop event hook, same as other
# plugin daemons (see e.g. the netbird-unraid plugin for precedent).
#
# Runtime: Node.js + Single Executable Applications (SEA) - see ROADMAP.md.
# EXEC below still points at a plain `node index.js` invocation as a
# placeholder; the SEA build step (turning src/ into a standalone binary with
# no system Node.js dependency) isn't wired up yet, so this line will change
# to exec that compiled binary directly once it is.

PIDFILE="/var/run/unraid-disklocation-next.pid"
EXEC="/usr/local/emhttp/plugins/unraid-disklocation-next/app/unraid-disklocation-next"
LOGFILE="/var/log/unraid-disklocation-next.log"

start() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "unraid-disklocation-next already running"
    return 0
  fi
  nohup $EXEC >>"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if [[ -f "$PIDFILE" ]]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 start|stop|restart" ;;
esac
