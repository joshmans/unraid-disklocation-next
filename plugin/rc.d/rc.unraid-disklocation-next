#!/bin/bash
# Lifecycle script for the unraid-disklocation-next daemon.
#
# Installed to /usr/local/etc/rc.d/ (NOT /etc/rc.d/, which Unraid owns as a
# runtime symlink - packaging into it can break nginx/php-fpm/samba/docker).
# Started/stopped via an array-start/array-stop event hook, same as other
# plugin daemons (see e.g. the netbird-unraid plugin for precedent).
#
# Runtime: Node.js + Single Executable Applications (SEA) - see ROADMAP.md.
# start() execs the compiled standalone binary directly - no system Node.js
# dependency (Unraid doesn't bundle Node itself).
#
# NODE_TLS_REJECT_UNAUTHORIZED=0 used to be set here (a wrong assumption
# dropped it briefly during the SEA rework, which broke every /disks call
# with a bare "TypeError: fetch failed" on a real install - confirmed live),
# because unraid-api's GraphQL endpoint is served over HTTPS with Unraid's
# own self-signed certificate. That env var disables certificate checking
# for the whole process, not just that one request - flagged by the CA
# security review that landed the loopback-binding fix in #4. graphql/
# client.ts now makes that POST by hand and skips certificate checking only
# for that request, and only when graphqlUrl is loopback, so this is no
# longer needed here.
#
# The port is read from layout.json via jq (already relied on elsewhere in
# Unraid's own rc.nginx, not a new dependency) - user-configurable through
# the Settings tab, but only while the daemon isn't running (see
# ../daemon-control.php's set-port action).

PIDFILE="/var/run/unraid-disklocation-next.pid"
LAYOUT_PATH="/boot/config/plugins/unraid-disklocation-next/layout.json"
APP_BIN="/usr/local/emhttp/plugins/unraid-disklocation-next/app/bin/unraid-disklocation-next"
LOGFILE="/var/log/unraid-disklocation-next.log"

running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if running; then
    echo "unraid-disklocation-next already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  # User-configurable via the Settings tab's port field (daemon-control.php's
  # set-port action) - only ever taken while the daemon isn't running, so
  # there's no live-reconfiguration case to handle here, just read-at-start.
  local port
  port="$(jq -r '.port // 3838' "$LAYOUT_PATH" 2>/dev/null)"
  [[ "$port" =~ ^[0-9]+$ ]] || port=3838
  nohup /usr/bin/env PORT="$port" "$APP_BIN" >>"$LOGFILE" 2>&1 &
  local pid=$!
  echo "$pid" >"$PIDFILE"
  # A naive `echo $!` here can't tell a real start from one that immediately
  # crashed (e.g. EADDRINUSE from a not-yet-released port) - confirmed for
  # real: an immediate restart used to report success while the process had
  # already died, silently leaving nothing running.
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    echo "unraid-disklocation-next started (pid $pid)"
  else
    echo "unraid-disklocation-next FAILED to start - see $LOGFILE"
    rm -f "$PIDFILE"
    return 1
  fi
}

stop() {
  if ! running; then
    echo "unraid-disklocation-next already stopped"
    rm -f "$PIDFILE"
    return 0
  fi
  local pid
  pid="$(cat "$PIDFILE")"
  kill "$pid" 2>/dev/null
  # `kill` only sends the signal and returns immediately - it doesn't wait
  # for the process to actually exit. Without this wait, an immediate
  # `restart` races a new process's bind() against the old one still holding
  # the port, which fails with EADDRINUSE (reproduced against the real box).
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.3
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "unraid-disklocation-next did not stop gracefully after 6s, killing"
    kill -9 "$pid" 2>/dev/null
    sleep 0.3
  fi
  rm -f "$PIDFILE"
  echo "unraid-disklocation-next stopped"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 start|stop|restart" ;;
esac
