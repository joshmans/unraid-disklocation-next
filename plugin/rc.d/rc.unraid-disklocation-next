#!/bin/bash
# Lifecycle script for the unraid-disklocation-next daemon.
#
# Installed to /usr/local/etc/rc.d/ (NOT /etc/rc.d/, which Unraid owns as a
# runtime symlink - packaging into it can break nginx/php-fpm/samba/docker).
# Started/stopped via an array-start/array-stop event hook, same as other
# plugin daemons (see e.g. the netbird-unraid plugin for precedent).
#
# Runtime: Node.js + Single Executable Applications (SEA) - see ROADMAP.md.
# EXEC below still runs the plain compiled JS via system Node (with
# NODE_TLS_REJECT_UNAUTHORIZED=0 for unraid-api's self-signed cert) as a
# placeholder; the SEA build step (turning src/ into a standalone binary with
# no system Node.js dependency) isn't wired up yet, so this line will change
# to exec that compiled binary directly once it is.

PIDFILE="/var/run/unraid-disklocation-next.pid"
EXEC="/usr/bin/env NODE_TLS_REJECT_UNAUTHORIZED=0 /usr/local/bin/node /usr/local/emhttp/plugins/unraid-disklocation-next/app/dist/index.js"
LOGFILE="/var/log/unraid-disklocation-next.log"

running() {
  [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null
}

start() {
  if running; then
    echo "unraid-disklocation-next already running (pid $(cat "$PIDFILE"))"
    return 0
  fi
  nohup $EXEC >>"$LOGFILE" 2>&1 &
  local pid=$!
  echo "$pid" >"$PIDFILE"
  # A naive `echo $!` here can't tell a real start from one that immediately
  # crashed (e.g. EADDRINUSE from a not-yet-released port) - confirmed for
  # real: an immediate restart used to report success while the process had
  # already died, silently leaving nothing running.
  sleep 1
  if kill -0 "$pid" 2>/dev/null; then
    echo "unraid-disklocation-next started (pid $pid)"
  else
    echo "unraid-disklocation-next FAILED to start - see $LOGFILE"
    rm -f "$PIDFILE"
    return 1
  fi
}

stop() {
  if ! running; then
    echo "unraid-disklocation-next already stopped"
    rm -f "$PIDFILE"
    return 0
  fi
  local pid
  pid="$(cat "$PIDFILE")"
  kill "$pid" 2>/dev/null
  # `kill` only sends the signal and returns immediately - it doesn't wait
  # for the process to actually exit. Without this wait, an immediate
  # `restart` races a new process's bind() against the old one still holding
  # the port, which fails with EADDRINUSE (reproduced against the real box).
  for _ in $(seq 1 20); do
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.3
  done
  if kill -0 "$pid" 2>/dev/null; then
    echo "unraid-disklocation-next did not stop gracefully after 6s, killing"
    kill -9 "$pid" 2>/dev/null
    sleep 0.3
  fi
  rm -f "$PIDFILE"
  echo "unraid-disklocation-next stopped"
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 start|stop|restart" ;;
esac
