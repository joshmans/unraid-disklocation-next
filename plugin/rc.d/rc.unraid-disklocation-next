#!/bin/bash
# Lifecycle script for the unraid-disklocation-next daemon.
#
# Installed to /usr/local/etc/rc.d/ (NOT /etc/rc.d/, which Unraid owns as a
# runtime symlink - packaging into it can break nginx/php-fpm/samba/docker).
# Started/stopped via an array-start/array-stop event hook, same as other
# plugin daemons (see e.g. the netbird-unraid plugin for precedent).
#
# TODO: EXEC currently assumes a system Node.js runtime. Still deciding
# between that (extra install dependency, e.g. NerdPack) and shipping a
# self-contained compiled binary (Bun --compile / Node SEA / pkg) so the
# plugin has no external runtime dependency - see ROADMAP.md.

PIDFILE="/var/run/unraid-disklocation-next.pid"
EXEC="/usr/bin/node /usr/local/emhttp/plugins/unraid-disklocation-next/app/src/index.js"
LOGFILE="/var/log/unraid-disklocation-next.log"

start() {
  if [[ -f "$PIDFILE" ]] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
    echo "unraid-disklocation-next already running"
    return 0
  fi
  nohup $EXEC >>"$LOGFILE" 2>&1 &
  echo $! >"$PIDFILE"
}

stop() {
  if [[ -f "$PIDFILE" ]]; then
    kill "$(cat "$PIDFILE")" 2>/dev/null
    rm -f "$PIDFILE"
  fi
}

case "$1" in
  start) start ;;
  stop) stop ;;
  restart) stop; start ;;
  *) echo "usage: $0 start|stop|restart" ;;
esac
